// Snapshots are append-only: one row per successful poll. Nothing here is ever updated,
// which makes the file trivially safe to copy while the poller is running.
//
// Types are kept Postgres-compatible so the provider can be swapped by editing the datasource
// block alone. `breakdown` is stored whole rather than normalised into rows: it is what makes
// it possible to re-slice history later (e.g. net worth excluding one lucky mirror drop)
// without re-fetching anything from GGG.

generator client {
  provider = "prisma-client-js"
  // Deterministic location, on purpose.
  //
  // By default the generated client is written into node_modules/.prisma, which under pnpm
  // lives inside the virtual store next to a hashed directory name. Nothing outside pnpm can
  // find it reliably — the packaged desktop build shipped the ungenerated @prisma/client stub
  // instead and died at startup on "Named export 'PrismaClient' not found", which is the same
  // trap the Dockerfile hit from a different direction.
  //
  // Emitting into the repository makes the client an ordinary directory that any packager
  // copies like any other file. It is gitignored; `prisma generate` recreates it.
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Snapshot {
  id          Int      @id @default(autoincrement())
  takenAt     DateTime @default(now())
  league      String
  totalChaos  Float
  totalDivine Float
  divineRate  Float // chaos per divine at time of snapshot
  itemCount   Int
  breakdown   Json // { [tabName]: { [itemName]: { qty, chaosEach, chaosTotal } } }
  priceSetAt  DateTime // when the poe.ninja price set was fetched

  @@index([league, takenAt])
}

model PriceSet {
  id         Int      @id @default(autoincrement())
  league     String
  fetchedAt  DateTime @default(now())
  prices     Json // { [itemName]: chaosValue }
  // { [itemName]: iconUrl }. Lives here rather than in Snapshot.breakdown because an icon is a
  // property of the item, not of a moment in time — repeating it in every snapshot would grow
  // the largest column in the database 144 times a day to store the same strings.
  // Nullable so the migration lands on existing rows with no backfill; the next fetch fills it.
  icons      Json?
  // { [poeNinjaId]: category }, e.g. { "gilded-bestiary-scarab": "Scarab" }. Recorded at fetch
  // time because that is the only moment it is known: the app asks poe.ninja one category at a
  // time, and the payload itself says nothing about which one it answered. Deriving it later
  // from an item's name would be guesswork over a fact we already had.
  categories Json?

  @@index([league, fetchedAt])
}
