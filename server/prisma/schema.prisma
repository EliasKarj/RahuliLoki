// Snapshots are append-only: one row per successful poll. Nothing here is ever updated,
// which makes the file trivially safe to copy while the poller is running.
//
// Types are kept Postgres-compatible so the provider can be swapped by editing the datasource
// block alone. `breakdown` is stored whole rather than normalised into rows: it is what makes
// it possible to re-slice history later (e.g. net worth excluding one lucky mirror drop)
// without re-fetching anything from GGG.

generator client {
  provider = "prisma-client-js"
  // Deterministic location, on purpose.
  //
  // By default the generated client is written into node_modules/.prisma, which under pnpm
  // lives inside the virtual store next to a hashed directory name. Nothing outside pnpm can
  // find it reliably — the packaged desktop build shipped the ungenerated @prisma/client stub
  // instead and died at startup on "Named export 'PrismaClient' not found", which is the same
  // trap the Dockerfile hit from a different direction.
  //
  // Emitting into the repository makes the client an ordinary directory that any packager
  // copies like any other file. It is gitignored; `prisma generate` recreates it.
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Snapshot {
  id          Int      @id @default(autoincrement())
  takenAt     DateTime @default(now())
  league      String
  totalChaos  Float
  totalDivine Float
  divineRate  Float // chaos per divine at time of snapshot
  itemCount   Int
  breakdown   Json // { [tabName]: { [itemName]: { qty, chaosEach, chaosTotal } } }
  // { [tabName]: chaosTotal }: the per-tab sums of `breakdown`, written at the same moment.
  //
  // Derived data, stored on purpose. The dashboard asks for these on every refresh — they draw
  // the per-tab area chart — and computing them meant reading and parsing every breakdown blob
  // in the range. On a month of a nineteen-tab stash that is a hundred megabytes of JSON to
  // produce about a kilobyte of numbers, and it measured 2.3 seconds. Read from this column it
  // is a few milliseconds.
  //
  // Nullable so the migration lands on existing rows before its backfill has run; the read path
  // falls back to the breakdown for any row where it is still null.
  tabs        Json?
  priceSetAt  DateTime // when the poe.ninja price set was fetched

  @@index([league, takenAt])
}

model PriceSet {
  id         Int      @id @default(autoincrement())
  league     String
  fetchedAt  DateTime @default(now())
  prices     Json // { [itemName]: chaosValue }
  // { [itemName]: iconUrl }. Lives here rather than in Snapshot.breakdown because an icon is a
  // property of the item, not of a moment in time — repeating it in every snapshot would grow
  // the largest column in the database 144 times a day to store the same strings.
  // Nullable so the migration lands on existing rows with no backfill; the next fetch fills it.
  icons      Json?
  // { [poeNinjaId]: category }, e.g. { "gilded-bestiary-scarab": "Scarab" }. Recorded at fetch
  // time because that is the only moment it is known: the app asks poe.ninja one category at a
  // time, and the payload itself says nothing about which one it answered. Deriving it later
  // from an item's name would be guesswork over a fact we already had.
  categories Json?
  // { [poeNinjaId]: { change, volume, sparkline } } — what the price has been doing, as
  // poe.ninja publishes it on every line. Recorded because a number with no trend beside it is
  // the number you go and check somewhere else. Nullable for the same reason as the two above:
  // a row written before the column existed has none, and that is the honest reading of it.
  meta       Json?

  @@index([league, fetchedAt])
}

/// The uniques a poll last saw, one row per league.
///
/// Not history: this is overwritten every poll, because the question it answers is "what is in
/// my stash right now" and an answer from Tuesday is not an answer. It is stored rather than
/// held in memory so the tab has something to show the moment the app opens, instead of nothing
/// until the next poll comes round.
///
/// It lives outside Snapshot deliberately. A snapshot's breakdown is keyed by item name and
/// aggregated, which is the right shape for a wealth chart and the wrong one here: item level
/// and quality are per item, and putting them in every snapshot would multiply the largest
/// column in the database to record what does not change between polls.
model UniqueSet {
  id         Int      @id @default(autoincrement())
  league     String   @unique
  capturedAt DateTime @default(now())
  /// UniqueHolding[] — see services/kingsmarch.ts.
  holdings   Json
}
