{
  "name": "@valuuttaloki/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "node --env-file-if-exists=../.env --watch --experimental-strip-types src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=../.env dist/index.js",
    "db:migrate": "node ../scripts/with-env.mjs prisma migrate dev",
    "db:deploy": "node ../scripts/with-env.mjs prisma migrate deploy",
    "db:studio": "node ../scripts/with-env.mjs prisma studio",
    "seed": "node --env-file-if-exists=../.env tools/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "@prisma/client": "^6.3.1",
    "fastify": "^5.2.1",
    "node-cron": "^4.6.0",
    "prisma": "^6.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
