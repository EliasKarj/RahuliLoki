{
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],

    "strict": true,
    // An import or a local nobody reads is the first thing a codebase accumulates, and it never
    // announces itself: it compiles, it ships, and the next person has to work out whether it
    // mattered. Cheaper to make it fail here.
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,

    // Node runs the .ts sources directly in dev (type stripping), so imports carry a .ts
    // extension; tsc rewrites them to .js on emit.
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,

    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src", "test", "tools"]
}
