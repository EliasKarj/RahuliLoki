{
  "name": "@whatremains/desktop",
  "version": "1.1.2",
  "productName": "What Remains",
  "desktopName": "what-remains.desktop",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "package": "pnpm build && electron-builder --config electron-builder.yml --publish never",
    "package:dir": "pnpm build && electron-builder --config electron-builder.yml --dir --publish never",
    "start": "pnpm build && electron .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@whatremains/server": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "electron": "^39.8.10",
    "electron-builder": "^26.15.3",
    "typescript": "^5.7.3",
    "vitest": "^3.2.7"
  },
  "description": "Self-hosted Path of Exile wealth tracker, as a desktop application.",
  "author": "EliasKarj",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/EliasKarj/WhatRemains.git"
  }
}
