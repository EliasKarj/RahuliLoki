{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023"],
    "types": ["node"],
    "strict": true,
    // An import or a local nobody reads is the first thing a codebase accumulates, and it never
    // announces itself: it compiles, it ships, and the next person has to work out whether it
    // mattered. Cheaper to make it fail here.
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "noEmit": true,
    // The tests import source directly, the way the server's do. Only typecheck reads this
    // file; the build uses tsconfig.build.json, which emits and leaves the tests out.
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false
  },
  "include": ["src/**/*.ts", "src/**/*.cts", "test/**/*.ts"]
}
