# Copy to .env and fill in. .env is gitignored and must stay that way.
#
# POESESSID is a full account session credential, not a scoped API key. Anyone holding it
# can act as your GGG account. Never paste it into an issue, a log, or a screenshot.
# Read it out of the pathofexile.com cookie jar in your browser's devtools.
POESESSID=

# Exact account name as GGG spells it, including the discriminator (e.g. Exile#1234).
POE_ACCOUNT_NAME=

# League to track. Snapshots are keyed by this; never mix leagues in one series.
POE_LEAGUE=Standard

# Poll schedule. Ten minutes is a good balance between chart resolution and GGG's patience.
POLL_CRON=*/10 * * * *

# Items worth less than this many chaos are dropped from the breakdown to cut noise.
MIN_ITEM_CHAOS=2

# poe.ninja unique categories. Priced per variant (links + corruption), not by name.
# Empty the list to stop valuing uniques entirely.
PRICE_UNIQUE_CATEGORIES=UniqueWeapon,UniqueArmour,UniqueAccessory,UniqueJewel,UniqueFlask

# Comma-separated tab names to value. Empty = every tab the account has.
TRACKED_TABS=

# SQLite file. Mount the containing directory as a volume in production.
DATABASE_URL=file:./data/valuuttaloki.db

# Contact string appended to the User-Agent GGG sees. Put something they can reach you at.
POE_CONTACT=valuuttaloki (self-hosted; contact: you@example.com)

# HTTP port for the API + built SPA.
PORT=3000

# --- Access control -------------------------------------------------------------------
#
# Shared API token. Required whenever this is reachable from anywhere but this machine: the
# server refuses to boot on a non-loopback bind without one. Generate with:
#
#   openssl rand -hex 32
#
# What it guards: the account's full wealth history, its stash tab layout, and a POST
# /api/poll that spends its GGG rate-limit budget on demand.
AUTH_TOKEN=

# Interface to bind. Loopback by default, which is what makes an empty AUTH_TOKEN acceptable
# for local use. A container needs 0.0.0.0 to be reachable through a port mapping at all.
HOST=127.0.0.1

# Set only when something else is already authenticating: a reverse proxy with its own auth, a
# Tailscale-only interface, or a port published to 127.0.0.1. It waives the boot-time refusal
# above. It does not make an exposed instance safe.
ALLOW_UNAUTHENTICATED=

# Extra Host header values accepted in token-less mode, comma-separated; loopback names always
# are. This is the DNS-rebinding guard — without it, an attacker's domain pointed at 127.0.0.1
# counts as same-origin with your dashboard as far as the browser is concerned.
ALLOWED_HOSTS=

# Believe X-Forwarded-For and X-Forwarded-Proto. Turn on only when a proxy you control really
# is in front; otherwise any client can write its own address into your logs.
TRUST_PROXY=

# --- Limits ---------------------------------------------------------------------------
#
# Price sets kept per league. Each row holds a full name → chaos map and one is written per TTL
# lapse; unpruned they outgrow a small volume over a league. 0 keeps everything.
PRICE_SET_RETENTION=48

# Ceiling on a single request to GGG or poe.ninja. Requests are serialised, so an unbounded one
# does not merely slow the poller — it stops it until the process is restarted.
REQUEST_TIMEOUT_MS=30000
