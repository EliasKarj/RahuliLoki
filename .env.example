# Copy to .env and fill in. .env is gitignored and must stay that way.
#
# POESESSID is a full account session credential, not a scoped API key. Anyone holding it
# can act as your GGG account. Never paste it into an issue, a log, or a screenshot.
# Read it out of the pathofexile.com cookie jar in your browser's devtools.
POESESSID=

# Exact account name as GGG spells it, including the discriminator (e.g. Exile#1234).
POE_ACCOUNT_NAME=

# League to track. Snapshots are keyed by this; never mix leagues in one series.
POE_LEAGUE=Standard

# Poll schedule. Ten minutes is a good balance between chart resolution and GGG's patience.
POLL_CRON=*/10 * * * *

# Items worth less than this many chaos are dropped from the breakdown to cut noise.
MIN_ITEM_CHAOS=2

# Comma-separated tab names to value. Empty = every tab the account has.
TRACKED_TABS=

# SQLite file. Mount the containing directory as a volume in production.
DATABASE_URL=file:./data/valuuttaloki.db

# Contact string appended to the User-Agent GGG sees. Put something they can reach you at.
POE_CONTACT=valuuttaloki (self-hosted; contact: you@example.com)

# HTTP port for the API + built SPA.
PORT=3000
