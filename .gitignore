node_modules/
dist/
# Generated Prisma client (see schema.prisma). Recreated by `prisma generate`.
server/generated/
build/
# …except the packaging assets, which are inputs rather than outputs: the icons the installer
# needs, and the script that draws them. CI has no image library to regenerate them with.
!desktop/build/
coverage/
release/

# POESESSID lives here. Never commit.
.env
.env.*
!.env.example

# SQLite database + backups. The -wal and -shm sidecars hold committed rows that have not
# been checkpointed back into the main file yet, so they are as sensitive as the .db itself.
#
# Anchored to the repository root, and no bare `data/` beside it. A bare rule matches a
# directory of that name at *any* depth, and it silently swallowed server/src/data — the
# vendored dust table and its licence notice — so they were never committed and CI could not
# build. Nothing is lost by dropping it: every deployment puts the database at /data/, and the
# file patterns below catch a stray .db wherever it lands.
/data/
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite-wal
*.sqlite-shm

.DS_Store
*.log
.vite/
